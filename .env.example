# Copy to .env and fill in before deploying. Values shown are the defaults the backend
# falls back to when a variable is unset — except SECRET_KEY and the seed accounts, which
# have no usable default on purpose.

# ── Required in production ────────────────────────────────────────────────────────────
# Signs JWT session tokens. Leave unset and the backend generates a random key at startup,
# which logs a warning, invalidates every session on restart, and breaks multi-replica
# deployments because each replica signs with a different key.
#   openssl rand -hex 32
SECRET_KEY=

# ── Seed accounts ─────────────────────────────────────────────────────────────────────
# Created on first boot if they do not exist. Leave blank to create no accounts at all and
# register the first user through the UI instead. A username without a password is skipped.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_USER_USERNAME=
DEFAULT_USER_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_studio?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINUTES=30
DB_MAX_CONN_IDLE_MINUTES=15
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_RETRY_INTERVAL_SECONDS=2

# ── Redis (optional) ──────────────────────────────────────────────────────────────────
# Without Redis the backend runs in-memory, which is fine for a single replica.
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# ── Core TTS engine ───────────────────────────────────────────────────────────────────
CORE_ENGINE_URL=http://localhost:8001
CORE_ENGINE_GRPC_URL=localhost:50051
TTS_CLIENT_TIMEOUT_SECONDS=60

# Notified to rebuild the prerendered bundle when the engine's manifest changes.
FE_BUILDER_URL=http://frontend-builder:3001

# ── Storage ───────────────────────────────────────────────────────────────────────────
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=32
# Hours to keep generated audio in storage/temp before it is swept. Files are removed on a
# hourly sweep; without this the directory grows for the lifetime of the deployment.
TEMP_AUDIO_RETENTION_HOURS=24

# ── CORS ──────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
