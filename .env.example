# Sinh tự động từ core-backend/config/settings.go — đừng sửa tay.
# Cập nhật bằng: cd core-backend && go generate ./config
#
# Sao chép thành .env rồi điền trước khi triển khai. Giá trị hiển thị là mặc định backend
# dùng khi biến không được đặt; biến nào đánh dấu BẮT BUỘC thì không có mặc định an toàn.

# ── Required in production ──────────────────────────────────────────────────────────────
# BẮT BUỘC cho môi trường thật.
# Ký JWT phiên đăng nhập. Bỏ trống thì backend tự sinh khoá ngẫu nhiên lúc khởi động: có
# cảnh báo trong log, mọi phiên mất hiệu lực sau mỗi lần khởi động lại, và nhiều replica
# không dùng chung được phiên vì mỗi bản ký bằng một khoá khác nhau.
#   openssl rand -hex 32
SECRET_KEY=

# ── Seed accounts ───────────────────────────────────────────────────────────────────────
# Tài khoản tạo sẵn ở lần khởi động đầu nếu chưa tồn tại. Để trống toàn bộ nhóm này thì
# không tài khoản nào được tạo và người dùng đầu tiên tự đăng ký qua giao diện. Một
# username thiếu password sẽ bị bỏ qua.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_USER_USERNAME=
DEFAULT_USER_PASSWORD=

# ── Server ──────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Thời hạn token đăng nhập. Mặc định 7 ngày.
# Số nguyên trong khoảng 1 đến 525600.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Số giây ghi nhớ bản ghi người dùng sau khi xác thực token, để mỗi request không
# phải hỏi lại PostgreSQL cùng một câu. Chỉ role và trạng thái duyệt cần tươi, nên
# độ trễ vài giây là chấp nhận được; duyệt tài khoản sẽ xoá cache ngay lập tức.
# Đặt 0 để tắt cache và quay về truy vấn từng request.
# Số nguyên trong khoảng 0 đến 3600.
AUTH_USER_CACHE_SECONDS=15

# ── Database ────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_studio?sslmode=disable
# Số nguyên trong khoảng 1 đến 10000.
DB_MAX_CONNS=25
# Không được lớn hơn DB_MAX_CONNS.
# Số nguyên trong khoảng 0 đến 10000.
DB_MIN_CONNS=5
# Số nguyên trong khoảng 1 đến 10080.
DB_MAX_CONN_LIFETIME_MINUTES=30
# Số nguyên trong khoảng 1 đến 10080.
DB_MAX_CONN_IDLE_MINUTES=15
# Số nguyên trong khoảng 1 đến 1000.
DB_CONNECT_MAX_RETRIES=10
# Số nguyên trong khoảng 1 đến 3600.
DB_CONNECT_RETRY_INTERVAL_SECONDS=2

# ── Redis (optional) ────────────────────────────────────────────────────────────────────
# Không có Redis thì backend chạy chế độ in-memory, đủ dùng cho một replica.
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# ── Core TTS engine ─────────────────────────────────────────────────────────────────────
# Nơi backend lấy manifest và gửi yêu cầu tổng hợp.
CORE_ENGINE_URL=http://localhost:8001
CORE_ENGINE_GRPC_URL=localhost:50051
# Số nguyên trong khoảng 1 đến 3600.
TTS_CLIENT_TIMEOUT_SECONDS=60

# ── Frontend builder ────────────────────────────────────────────────────────────────────
# Backend gọi URL này khi manifest đổi, để builder dựng lại bundle prerender.
# Tín hiệu không mang dữ liệu — builder tự lấy manifest qua VITE_BACKEND_URL.
FE_BUILDER_URL=http://frontend-builder:3001
# Đọc bởi frontend, không phải backend.
# Chiều ngược lại: nơi builder và dev server tìm backend để lấy manifest.
# Backend không đọc biến này — nó nằm đây vì là nửa còn lại của cùng một liên kết,
# và tách riêng ra một chỗ khác thì người vận hành phải nhớ hai nơi.
# Đây là biến khởi động: không thể lấy từ manifest, vì cần nó mới lấy được manifest.
VITE_BACKEND_URL=http://core-backend:8000

# ── Storage ─────────────────────────────────────────────────────────────────────────────
STORAGE_DIR=storage
# Trần cứng của hạ tầng cho một request tải lên — nói về RAM và băng thông của
# deployment, không phải về model. Engine khai trần riêng trong
# audio_spec.max_upload_bytes; cái nào chặt hơn thì thắng.
# Số nguyên trong khoảng 1 đến 10240.
MAX_UPLOAD_SIZE_MB=256
# Số giờ giữ âm thanh đã sinh trong storage/temp. Bộ quét chạy mỗi giờ và một lần lúc
# khởi động; không có nó thư mục sẽ phình lên suốt vòng đời triển khai.
# Số nguyên trong khoảng 1 đến 8760.
TEMP_AUDIO_RETENTION_HOURS=24

# ── CORS ────────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
