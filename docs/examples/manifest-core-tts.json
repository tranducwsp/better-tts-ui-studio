{
    "engine_id": "core-engine-v1",
    "engine_name": "Universal Core AI Engine",
    "version": "1.0.0",
    "provider": "Universal AI Platform",
    "supported_modes": [
        {
            "id": "standard",
            "name": "Standard Neural",
            "description": "High fidelity neural voice inference",
            "capabilities": {
                "supports_cloning": false,
                "supports_voice_saving": false
            }
        },
        {
            "id": "fast",
            "name": "Fast Streaming",
            "description": "Low latency streaming TTS",
            "capabilities": {
                "supports_cloning": false,
                "supports_voice_saving": false
            }
        },
        {
            "id": "clone",
            "name": "Voice Cloning",
            "description": "Reference audio speaker cloning",
            "capabilities": {
                "supports_cloning": true,
                "supports_voice_saving": true
            }
        }
    ],
    "capabilities": {
        "supports_preset_voices": true,
        "supports_cloning": false,
        "supports_voice_saving": false,
        "supports_streaming": true,
        "supports_speed": true,
        "supports_pitch": false,
        "supports_emotion": false,
        "supports_ssml": false
    },
    "constraints": {
        "max_text_length": 3000,
        "speed_range": {
            "min": 0.5,
            "max": 2,
            "default": 1,
            "step": 0.1
        },
        "pitch_range": {
            "min": -10,
            "max": 10,
            "default": 0,
            "step": 0.5
        },
        "supported_emotions": [],
        "chunking": {
            "max_chunk_size": 1000,
            "delimiters": [
                "(?<=\\.\\s*\\n)",
                "(?<=[.!?]\\s+)"
            ]
        }
    },
    "audio_spec": {
        "supported_formats": [
            "wav",
            "mp3"
        ],
        "supported_sample_rates": [
            16000,
            22050,
            24000,
            44100
        ],
        "default_format": "wav",
        "default_sample_rate": 24000,
        "max_upload_bytes": 10485760,
        "reference_audio_seconds": 5
    },
    "ui_schema": {
        "ui_mode": "beauty",
        "input_panel": {
            "file_serve": true,
            "closeable": false,
            "find_mode": "expert",
            "replace_tool": true,
            "enable_chunk_box": true,
            "auto_format": [
                {
                    "find": "\\r\\n",
                    "replace": "\n"
                },
                {
                    "find": "\\n{3,}",
                    "replace": "\n\n"
                },
                {
                    "find": "\\u00D0",
                    "replace": "\u0110"
                },
                {
                    "find": "([a-zA-Z\u00c0-\u1ef9])\\-([a-zA-Z\u00c0-\u1ef9])",
                    "replace": "\\1 \\2"
                },
                {
                    "find": "[\u2070\u00b9\u00b2\u00b3\u2074\u2075\u2076\u2077\u2078\u2079\u2080\u2081\u2082\u2083\u2084\u2085\u2086\u2087\u2088\u2089]",
                    "replace": ""
                },
                {
                    "find": "[^a-zA-Z0-9 \\n\\t\\r.,?!;:\\-\\\"'()\\[\\]%/\u201c\u201d\u2018\u2019\u00c0-\u1ef9]",
                    "replace": ""
                }
            ]
        },
        "model_sort": [
            "fast",
            "standard",
            "clone"
        ],
        "option_panel": {
            "standard": {
                "voice_type": "select",
                "speed_type": "slider"
            },
            "clone": {
                "voice_type": "select",
                "speed_type": "slider",
                "voice_metadata_schema": [
                    {
                        "key": "name",
                        "label": "Voice Name",
                        "type": "text",
                        "required": true,
                        "placeholder": "e.g. Male Narrator..."
                    },
                    {
                        "key": "gender",
                        "label": "Gender",
                        "type": "select",
                        "options": [
                            "Male",
                            "Female",
                            "Other"
                        ]
                    },
                    {
                        "key": "region",
                        "label": "Accent / Region",
                        "type": "select",
                        "options": [
                            "North American",
                            "British",
                            "Australian",
                            "Other"
                        ]
                    },
                    {
                        "key": "style",
                        "label": "Style",
                        "type": "select",
                        "options": [
                            "Expressive",
                            "News / Broadcast",
                            "Audiobook / Reading",
                            "Dramatic",
                            "Natural / Conversational",
                            "Commercial",
                            "Other"
                        ]
                    }
                ]
            },
            "fast": {
                "notice_banner": {
                    "level": "warning",
                    "message": "Note: This cloud voice model processes data externally. Avoid sending confidential information."
                },
                "voice_type": "radio",
                "speed_type": "slider",
                "preset_voices": [
                    {
                        "id": "Voice A (Female)",
                        "name": "Voice A (Female)",
                        "gender": "female"
                    },
                    {
                        "id": "Voice B (Male)",
                        "name": "Voice B (Male)",
                        "gender": "male"
                    }
                ]
            }
        }
    }
}
