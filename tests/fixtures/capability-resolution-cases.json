{
  "_comment": "Shared fixtures for the capability resolver. Both backend/tests/schema_parity_test.go and frontend/src/lib/capabilities.test.ts read this file, so the Go and TypeScript resolvers are checked against identical input rather than two hand-written copies that can drift apart.",
  "manifest": {
    "capabilities": {
      "supports_pitch": false,
      "supports_emotion": false,
      "supports_streaming": true,
      "supports_cloning": true
    },
    "supported_modes": [
      { "id": "inherits", "name": "Inherits everything", "description": "" },
      {
        "id": "opts_in",
        "name": "Opts in to pitch",
        "description": "",
        "capabilities": { "supports_pitch": true, "supports_emotion": true }
      },
      {
        "id": "opts_out",
        "name": "Opts out of an engine-wide feature",
        "description": "",
        "capabilities": { "supports_streaming": false, "supports_cloning": false }
      },
      {
        "id": "empty_caps",
        "name": "States an empty capability block",
        "description": "",
        "capabilities": {}
      }
    ]
  },
  "cases": [
    {
      "why": "mode states nothing: engine values win, unstated fields fall to platform defaults",
      "mode": "inherits",
      "expect": {
        "supports_preset_voices": true,
        "supports_cloning": true,
        "supports_voice_saving": false,
        "supports_streaming": true,
        "supports_speed": true,
        "supports_pitch": false,
        "supports_emotion": false
      }
    },
    {
      "why": "mode opts in to features the engine disables",
      "mode": "opts_in",
      "expect": {
        "supports_preset_voices": true,
        "supports_cloning": true,
        "supports_voice_saving": false,
        "supports_streaming": true,
        "supports_speed": true,
        "supports_pitch": true,
        "supports_emotion": true
      }
    },
    {
      "why": "mode opts OUT of features the engine enables — false must beat engine true",
      "mode": "opts_out",
      "expect": {
        "supports_preset_voices": true,
        "supports_cloning": false,
        "supports_voice_saving": false,
        "supports_streaming": false,
        "supports_speed": true,
        "supports_pitch": false,
        "supports_emotion": false
      }
    },
    {
      "why": "an empty capability block is not the same as stating false",
      "mode": "empty_caps",
      "expect": {
        "supports_preset_voices": true,
        "supports_cloning": true,
        "supports_voice_saving": false,
        "supports_streaming": true,
        "supports_speed": true,
        "supports_pitch": false,
        "supports_emotion": false
      }
    },
    {
      "why": "unknown mode id resolves to the engine-wide set",
      "mode": "no_such_mode",
      "expect": {
        "supports_preset_voices": true,
        "supports_cloning": true,
        "supports_voice_saving": false,
        "supports_streaming": true,
        "supports_speed": true,
        "supports_pitch": false,
        "supports_emotion": false
      }
    },
    {
      "why": "empty mode id resolves to the engine-wide set",
      "mode": "",
      "expect": {
        "supports_preset_voices": true,
        "supports_cloning": true,
        "supports_voice_saving": false,
        "supports_streaming": true,
        "supports_speed": true,
        "supports_pitch": false,
        "supports_emotion": false
      }
    }
  ],
  "platform_defaults": {
    "supports_preset_voices": true,
    "supports_cloning": false,
    "supports_voice_saving": false,
    "supports_streaming": true,
    "supports_speed": true,
    "supports_pitch": false,
    "supports_emotion": false
  },
  "default_max_text_length": 3000
}