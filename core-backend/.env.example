# Application Configuration
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORE_TTS_URL=http://localhost:8001

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Redis Cache & PubSub Configuration
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vieneu_tts?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINUTES=30
DB_MAX_CONN_IDLE_MINUTES=15
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_RETRY_INTERVAL_SECONDS=2

# Storage & Upload Limits
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=32
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
TTS_CLIENT_TIMEOUT_SECONDS=60

# Default Accounts
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_admin_password
DEFAULT_USER_USERNAME=user
DEFAULT_USER_PASSWORD=change_this_user_password
